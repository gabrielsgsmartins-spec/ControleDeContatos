@model ContatoModel
@{
    ViewData["Title"] = "Confirmação de apagar o contato";
}
<div class="text-center">

    <h3>Realmente deseja apagar o contato ? </h3>

</div>

<a class="btn btn-success w-100" role="button" asp-controller="Contato" asp-action="Index">Cancelar exclusão</a>
<a class="btn btn-danger w-100" role="button "Contato" asp-action="Apagar" asp-route-id="@Model.Id">Confirmar exclusão</a>