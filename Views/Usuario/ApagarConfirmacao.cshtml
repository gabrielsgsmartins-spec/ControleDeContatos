@model UsuarioModel
@{
    ViewData["Title"] = "Confirmação de apagar o usuario";
}
<div class="text-center">

    <h3>Realmente deseja apagar o usuario ? </h3>

</div>

<a class="btn btn-success w-100" asp-controller="Usuario" asp-action="Index">Cancelar exclusão</a>
<a class="btn btn-danger w-100" asp-controller="Usuario" asp-action="Apagar" asp-route-id="@Model.Id">Confirmar exclusão</a>